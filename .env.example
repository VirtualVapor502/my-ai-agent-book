# ===== 复制本文件为 .env 并填入真实值；.env 永远不进 git =====
# 四家任选其一：LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 各留一行有效值，其余注释掉

# --- 阿里云百炼 DashScope（通义 Qwen）---
# 开通：https://bailian.console.aliyun.com → API-KEY 管理
LLM_API_KEY=sk-你的dashscope-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# --- Kimi（月之暗面 Moonshot）---
# 开通：https://platform.moonshot.cn → API Key 管理
# LLM_API_KEY=sk-你的kimi-key
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k3

# --- DeepSeek ---
# 开通：https://platform.deepseek.com → API keys
# LLM_API_KEY=sk-你的deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- 智谱 GLM ---
# 开通：https://open.bigmodel.cn → API keys
# LLM_API_KEY=你的glm-key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5

# 注意：端点错 = 连不上；模型名错 = 404/400。模型名以各平台"模型列表"页为准
